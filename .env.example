# LaunchReel MCP server (audio library + launch references). Copy to .env (git-ignored) or export in your shell.
# Every key is optional: a missing key disables only that provider.

# Freesound SFX search. Free key: https://freesound.org/apiv2/apply
FREESOUND_API_KEY=
# Optional: download original files instead of HQ MP3 previews (needs an OAuth2 access token).
FREESOUND_OAUTH_TOKEN=
FREESOUND_DOWNLOAD_ORIGINALS=0

# Jamendo music search. Free client id: https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# Optional Openverse OAuth client for higher rate limits (anonymous works: 20 req/min, 200/day).
# Register: POST https://api.openverse.org/v1/auth_tokens/register/
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# --- Launch-video reference research (all optional) ---------------------------
# YouTube Data API v3 key (Google Cloud console, no billing needed for the free quota).
YOUTUBE_API_KEY=
# Local guard; defaults match Google's default quota (search.list: 100 calls/day; other methods: 10,000 units/day).
# YOUTUBE_SEARCH_DAILY_LIMIT=100
# YOUTUBE_DAILY_UNITS=10000
# Product Hunt developer token: https://www.producthunt.com/v2/oauth/applications (non-commercial use by default, see README)
PRODUCT_HUNT_TOKEN=
# Vimeo personal access token with the "public" scope: https://developer.vimeo.com/apps
VIMEO_TOKEN=
# REFERENCES_TRANSCRIPTS=0                       # turn the transcript module off
# REFERENCES_CACHE_TTL_HOURS=24
# REFERENCES_CACHE_DIR=/abs/path                 # default: ${CLAUDE_PLUGIN_DATA}/references or workspace/cache/references
# LAUNCHREEL_REFERENCES_FILE=/abs/curated.yaml   # where save_reference writes
# LAUNCHREEL_CHANNELS_FILE=/abs/channels.yaml

# Optional overrides
# AUDIO_DOWNLOAD_DIR=/abs/path/for/downloads     # default: workspace/audio-library
# AUDIO_PACKS_DIR=/abs/path/to/audio-packs       # default: assets/audio-packs
# AUDIO_CACHE_DIR=/abs/path/to/cache             # default: ${CLAUDE_PLUGIN_DATA}/audio-lib or workspace/cache/audio-lib
# AUDIO_CACHE_TTL_HOURS=24
# AUDIO_MAX_DOWNLOAD_MB=200
# AUDIO_PROVIDERS=openverse,freesound,jamendo,archive,local
# AUDIO_OFFLINE=1                                # local packs only, no network

# --- Launch Radar Shorts pipeline (shorts/) ------------------------------------
# Optional GitHub token (no scopes needed): raises search limits from 10 to 30 req/min.
GITHUB_TOKEN=
# YouTube upload (OAuth client from any Google Cloud project; the token must be granted by the channel's account).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Instagram auto-posting (docs: README → Autopilot). A Meta developer app (type Business) with
# Facebook Login; the Instagram account must be a professional account linked to a Facebook Page.
META_APP_ID=
META_APP_SECRET=

# --- Per channel: NOT in this file ----------------------------------------------
# Each channel's logins and switches live in ~/.config/motionhaus/channels/<slug>.env
# (created by `shorts channel new`, written by `shorts auth` and `shorts insta-auth`).
# They are ignored if set here, so one channel can never post as another:
#   YOUTUBE_REFRESH_TOKEN=
#   YOUTUBE_UPLOAD_MODE=manual      manual until your Google project passes YouTube's audit
#                                   (API uploads are locked private before that)
#   INSTAGRAM_PAGE_TOKEN=
#   INSTAGRAM_USER_ID=
#   INSTAGRAM_UPLOAD_MODE=manual    auto: `shorts insta-post` posts the reel due today;
#                                   back to manual pauses all posting for that channel
TTS_PROVIDER=kokoro
ELEVENLABS_API_KEY=
